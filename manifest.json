{
  "manifest_version": 3,
  "name": "Markdown Editor",
  "version": "1.0.0",
  "description": "A simple Markdown editor that runs in a browser tab",
  "key": "",
  "permissions": ["storage", "tabs", "identity"],
  "oauth2": {
    "client_id": "140675578103-trv9mk7u31qklabu6gm1q35v1ub7cjth.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Markdown Editor"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
